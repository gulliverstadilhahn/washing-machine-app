# Copy to .env and fill in. .env is git-ignored.
#
# Local development with `npx supabase start` prints both of these values;
# for the real building, take them from the Supabase dashboard under
# Project Settings → API. The anon key is safe in the browser: it can only do
# what row level security allows, which here is SELECT and nothing else.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
